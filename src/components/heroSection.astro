---
import CursorFollower from "./cursorFollower.astro";
---
<section id="hero-section" data-nav-theme="light" class="relative w-full h-dvh min-h-screen overflow-hidden isolate bg-white">
    <canvas id="hero-grid" class="absolute inset-0 pointer-events-none"></canvas>
    <div id="hero-text" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10 flex flex-col items-center gap-3 px-4 sm:px-5 pt-4 pb-3 sm:py-5 bg-white/70 backdrop-blur-xs">
        <h1 class="opacity-100 text-nowrap text-5xl sm:text-6xl md:text-[5.5rem] font-black font-doto leading-[0.9] tracking-[-0.04em] text-center">
            |DAVID---|<br />
            |KONEVKY-|</h1>
        <p class="font-medium text-center px-9">Design Engineer</p>
    </div>
</section>

<script>
    import gsap from "gsap";

    const CONFIG = {
        cellSize: 10,
        gap: 0.5,
        waitBetweenSweeps: 0,
        sweepDurationMs: 5000,
        msPerCell: null as number | null,
        noiseScale: 0.06,
        charColor: "#000000",
        fontFamily: "monospace",
    };

    const DENSITY_RAMP = " .:-=+*#%@";

    function buildPermutation(seed: number) {
        let s = seed >>> 0;
        function rand() {
            s ^= s << 13;
            s ^= s >>> 17;
            s ^= s << 5;
            s >>>= 0;
            return s / 4294967295;
        }
        const p = new Uint8Array(256);
        for (let i = 0; i < 256; i++) p[i] = i;
        for (let i = 255; i > 0; i--) {
            const j = Math.floor(rand() * (i + 1));
            [p[i], p[j]] = [p[j], p[i]];
        }
        const perm = new Uint8Array(512);
        for (let i = 0; i < 512; i++) perm[i] = p[i & 255];
        return perm;
    }

    function fade(t: number) {
        return t * t * t * (t * (t * 6 - 15) + 10);
    }

    function lerp(t: number, a: number, b: number) {
        return a + t * (b - a);
    }

    function grad(hash: number, x: number, y: number) {
        const h = hash & 3;
        const u = h < 2 ? x : y;
        const v = h < 2 ? y : x;
        return ((h & 1) === 0 ? u : -u) + ((h & 2) === 0 ? v : -v);
    }

    function makeNoise2D(seed: number) {
        const perm = buildPermutation(seed);
        return function noise2D(x: number, y: number) {
            const X = Math.floor(x) & 255;
            const Y = Math.floor(y) & 255;
            const xf = x - Math.floor(x);
            const yf = y - Math.floor(y);
            const u = fade(xf);
            const v = fade(yf);
            const aa = perm[perm[X] + Y];
            const ab = perm[perm[X] + Y + 1];
            const ba = perm[perm[X + 1] + Y];
            const bb = perm[perm[X + 1] + Y + 1];
            const x1 = lerp(u, grad(aa, xf, yf), grad(ba, xf - 1, yf));
            const x2 = lerp(u, grad(ab, xf, yf - 1), grad(bb, xf - 1, yf - 1));
            return (lerp(v, x1, x2) + 1) / 2;
        };
    }

    class NoiseGrid {
        canvas: HTMLCanvasElement;
        ctx: CanvasRenderingContext2D;
        config: typeof CONFIG;
        noise: (x: number, y: number) => number;
        offsetX: number;
        offsetY: number;
        baseNoiseScale: number;
        sweepTimer: ReturnType<typeof setTimeout> | null = null;
        cellTimer: ReturnType<typeof setTimeout> | null = null;
        cols = 0;
        rows = 0;
        _resizeTimer: ReturnType<typeof setTimeout> | undefined;

        constructor(canvas: HTMLCanvasElement, config: typeof CONFIG) {
            this.canvas = canvas;
            this.ctx = canvas.getContext("2d")!;
            this.config = config;
            this.noise = makeNoise2D((Math.random() * 0xffffffff) >>> 0);
            this.offsetX = Math.random() * 1000;
            this.offsetY = Math.random() * 1000;
            this.baseNoiseScale = config.noiseScale;
            this.resize();
            window.addEventListener("resize", () => this.debouncedResize());
        }

        debouncedResize() {
            clearTimeout(this._resizeTimer);
            this._resizeTimer = setTimeout(() => this.resize(), 150);
        }

        resize() {
            const dpr = window.devicePixelRatio || 1;
            const { cellSize, gap } = this.config;
            const w = window.innerWidth;
            const h = window.innerHeight;
            this.cols = Math.ceil(w / cellSize);
            this.rows = Math.ceil(h / cellSize);
            const totalW = this.cols * cellSize + gap;
            const totalH = this.rows * cellSize + gap;
            this.canvas.width = totalW * dpr;
            this.canvas.height = totalH * dpr;
            this.canvas.style.width = `${totalW}px`;
            this.canvas.style.height = `${totalH}px`;
            this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            this.ctx.textAlign = "center";
            this.ctx.textBaseline = "middle";
            this.drawAll();
        }

        valueAt(gx: number, gy: number) {
            const { noiseScale } = this.config;
            return this.noise((gx + this.offsetX) * noiseScale, (gy + this.offsetY) * noiseScale);
        }

        drawCell(gx: number, gy: number) {
            const { cellSize, gap, charColor, fontFamily } = this.config;
            const ctx = this.ctx;
            const v = this.valueAt(gx, gy);
            const rank = Math.min(DENSITY_RAMP.length - 1, Math.floor(v * DENSITY_RAMP.length));
            const char = DENSITY_RAMP[rank];
            const contentSize = Math.max(1, cellSize - gap);
            const offset = gap;
            const x = gx * cellSize + offset;
            const y = gy * cellSize + offset;
            ctx.clearRect(x, y, contentSize, contentSize);
            if (char === " ") return;
            ctx.fillStyle = charColor;
            ctx.font = `${contentSize}px ${fontFamily}`;
            ctx.fillText(char, x + contentSize / 2, y + contentSize / 2 + 1);
        }

        drawAll() {
            for (let gy = 0; gy < this.rows; gy++) {
                for (let gx = 0; gx < this.cols; gx++) this.drawCell(gx, gy);
            }
        }

        start() {
            this.scheduleSweep();
        }

        scheduleSweep() {
            clearTimeout(this.sweepTimer!);
            this.sweepTimer = setTimeout(() => this.runSweep(), this.config.waitBetweenSweeps);
        }

        runSweep() {
            this.noise = makeNoise2D((Math.random() * 0xffffffff) >>> 0);
            this.offsetX = Math.random() * 1000;
            this.offsetY = Math.random() * 1000;
            this.config.noiseScale = this.baseNoiseScale * (0.75 + Math.random() * 0.5);

            const total = this.cols * this.rows;
            const msPerCell = this.config.msPerCell ?? this.config.sweepDurationMs / Math.max(1, total);

            const MIN_TICK_MS = 4;
            const cellsPerTick = Math.max(1, Math.ceil(MIN_TICK_MS / Math.max(msPerCell, 0.001)));
            const tickDelay = msPerCell * cellsPerTick;

            let i = 0;
            const step = () => {
                if (i >= total) {
                    this.scheduleSweep();
                    return;
                }
                const end = Math.min(total, i + cellsPerTick);
                for (; i < end; i++) {
                    const gx = i % this.cols;
                    const gy = Math.floor(i / this.cols);
                    this.drawCell(gx, gy);
                }
                this.cellTimer = setTimeout(step, tickDelay);
            };
            clearTimeout(this.cellTimer!);
            step();
        }
    }

    function initGrid() {
        const canvas = document.querySelector<HTMLCanvasElement>("#hero-grid");
        if (!canvas) return;
        const grid = new NoiseGrid(canvas, CONFIG);
        grid.start();
    }

    initGrid();

    gsap.fromTo(
        "#hero-text",
        { opacity: 0 },
        { opacity: 1, duration: 1, delay: 0.2, ease: "power1.out" }
    );
</script>
