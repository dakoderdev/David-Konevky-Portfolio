---
import fs from "node:fs";
import path from "node:path";
import { PNG } from "pngjs";

interface Weights {
  square?: number;
  ringCircle?: number;
  fullCircle?: number;
}

interface Props {
  rows?: number;
  cols?: number;
  class?: string;
  /** Gap between cells, as a fraction of a single cell's size (e.g. 0.0005 = 0.05%). */
  gapRatio?: number;
  /** Relative weights for the three "dark" cell types. Don't need to sum to 1. */
  weights?: Weights;
  /** Optional seed for a reproducible layout; omit for a random one each render. */
  seed?: number;
  /** Path (relative to /public) to the image the grid maps its cells onto. */
  image?: string;
  /**
   * Fraction (0-1) of the luminance range treated as "extreme": a pixel
   * darker than 255 * (1 - extremeRatio) always becomes a solid square,
   * a pixel lighter than 255 * extremeRatio always becomes empty.
   * Everything in between is picked randomly from `weights`.
   */
  extremeRatio?: number;
  /** How many alternate layouts to precompute and crossfade between client-side. */
  variantCount?: number;
  /** Seconds between crossfades. */
  cycleSeconds?: number;
}

const {
  rows = 66,
  cols = 63,
  gapRatio = 0.075,
  weights = {},
  seed,
  image = "/map/hell-yeah.png",
  extremeRatio = 0.90,
  variantCount = 4,
  cycleSeconds = 1,
} = Astro.props;

const { square = 0.05, ringCircle = 0.32, fullCircle = 0.16 } = weights;

// mulberry32 PRNG, used only when a seed is provided so the layout can be reproducible.
function mulberry32(a: number) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

type CellType = "square" | "ringCircle" | "fullCircle" | "empty";

const totalDarkWeight = square + ringCircle + fullCircle;

function makePickDarkCellType(random: () => number) {
  return function pickDarkCellType(): CellType {
    let r = random() * totalDarkWeight;
    if ((r -= square) < 0) return "square";
    if ((r -= ringCircle) < 0) return "ringCircle";
    return "fullCircle";
  };
}

const gap = gapRatio;
const cellSize = 1 - gap;
const inset = gap / 2;

// Sample the source image on a rows x cols grid: dark pixels become one of the
// three "ink" cell types, white/light pixels become empty cells.
const imagePath = path.join(process.cwd(), "public", image);
const png = PNG.sync.read(fs.readFileSync(imagePath));

function sampleLuminance(row: number, col: number): number {
  const x0 = Math.floor((col / cols) * png.width);
  const x1 = Math.max(x0 + 1, Math.floor(((col + 1) / cols) * png.width));
  const y0 = Math.floor((row / rows) * png.height);
  const y1 = Math.max(y0 + 1, Math.floor(((row + 1) / rows) * png.height));

  let total = 0;
  let count = 0;
  for (let y = y0; y < y1; y++) {
    for (let x = x0; x < x1; x++) {
      const idx = (png.width * y + x) << 2;
      const r = png.data[idx];
      const g = png.data[idx + 1];
      const b = png.data[idx + 2];
      const a = png.data[idx + 3];
      // Treat transparent pixels as white/background.
      const luminance = a === 0 ? 255 : 0.299 * r + 0.587 * g + 0.114 * b;
      total += luminance;
      count++;
    }
  }

  return count > 0 ? total / count : 255;
}

// Luminance in the darkest/lightest `extremeRatio` fraction of the range is
// forced to a solid square / empty cell; everything in between is picked
// randomly from `weights`.
const hybridDarkCutoff = 255 * (1 - extremeRatio);
const hybridLightCutoff = 255 * extremeRatio;

// Precompute the luminance-derived "extreme" outcome (always square/empty)
// once, since it doesn't depend on randomness and is shared by every variant.
const luminances: number[] = [];
for (let row = 0; row < rows; row++) {
  for (let col = 0; col < cols; col++) {
    luminances.push(sampleLuminance(row, col));
  }
}

function buildVariant(random: () => number) {
  const pickDarkCellType = makePickDarkCellType(random);
  const cells: { type: CellType; row: number; col: number }[] = [];
  let i = 0;
  for (let row = 0; row < rows; row++) {
    for (let col = 0; col < cols; col++) {
      const luminance = luminances[i++];
      let type: CellType;
      if (luminance <= hybridDarkCutoff) type = "square";
      else if (luminance >= hybridLightCutoff) type = "empty";
      else type = pickDarkCellType();
      cells.push({ type, row, col });
    }
  }
  return cells;
}

const variants = Array.from({ length: Math.max(1, variantCount) }, (_, i) =>
  buildVariant(seed !== undefined ? mulberry32(seed + i) : Math.random)
);
---

<div class="blog-icon-wrap h-85 sm:h-101.5" data-cycle-seconds={cycleSeconds}>
  {
    variants.map((cells, variantIndex) => (
      <svg
        class="blog-icon h-85 sm:h-101.5"
        data-variant={variantIndex}
        style={{ opacity: variantIndex === 0 ? 1 : 0 }}
        viewBox={`0 0 ${cols} ${rows}`}
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        {cells.map(({ type, row, col }) => {
          const cx = col + 0.5;
          const cy = row + 0.5;

          if (type === "square") {
            return (
              <rect
                x={col + inset}
                y={row + inset}
                width={cellSize}
                height={cellSize}
                fill="black"
              />
            );
          }

          if (type === "ringCircle") {
            return (
              <circle
                cx={cx}
                cy={cy}
                r={cellSize * 0.395}
                stroke="black"
                stroke-width={cellSize * 0.2}
              />
            );
          }

          if (type === "fullCircle") {
            return <circle cx={cx} cy={cy} r={cellSize / 2} fill="black" />;
          }

          return null;
        })}
      </svg>
    ))
  }
</div>

<style>
  .blog-icon-wrap {
    position: relative;
    display: inline-block;
  }

  .blog-icon-wrap .blog-icon:not(:first-child) {
    position: absolute;
    inset: 0;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll<HTMLElement>(".blog-icon-wrap").forEach((wrap) => {
    gsap.fromTo(
      wrap,
      { rotate: 0 },
      {
        rotate: 6,
        duration: 2,
        delay: 0.4,
        scrollTrigger: {
          trigger: wrap,
          start: "top 85%",
          once: true,
        },
      }
    );

    const variants = Array.from(wrap.querySelectorAll<SVGElement>(".blog-icon"));
    if (variants.length < 2) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const cycleSeconds = Number(wrap.dataset.cycleSeconds) || 2.5;
    let current = 0;
    let active = false;
    let cycleCall: gsap.core.Tween | null = null;

    const stopCycle = () => {
      active = false;
      cycleCall?.kill();
      cycleCall = null;
    };

    const advance = () => {
      if (!active) return;

      const next = (current + 1) % variants.length;
      gsap.set(variants[current], { opacity: 0 });
      gsap.set(variants[next], { opacity: 1 });
      current = next;
      cycleCall = gsap.delayedCall(cycleSeconds, advance);
    };

    const startCycle = () => {
      if (active) return;

      active = true;
      cycleCall = gsap.delayedCall(cycleSeconds, advance);
    };

    const observer = new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? startCycle() : stopCycle()),
      { rootMargin: "150px 0px" }
    );

    observer.observe(wrap);

    const cleanup = () => {
      stopCycle();
      observer.disconnect();
    };

    document.addEventListener("astro:before-swap", cleanup, { once: true });
    window.addEventListener("pagehide", cleanup, { once: true });
  });
</script>
