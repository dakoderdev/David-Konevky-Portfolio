<div id="cursor-follower" class="z-600 absolute inset-0 mix-blend-difference pointer-events-none overflow-hidden"></div>

<script>
    import gsap from "gsap";

    const SPAWN_INTERVAL_MS = 20;
    const BLOOM_SIZE = 75;
    const FADE_DURATION = 2.5;
    const POOL_SIZE = 10;

    function initCursorFollower() {
        const wrap = document.querySelector<HTMLDivElement>("#cursor-follower");
        const host = wrap?.parentElement;
        if (!wrap || !host) return;

        // Reuse a fixed pool of blooms rather than growing the DOM forever.
        const pool = Array.from({ length: POOL_SIZE }, () => {
            const bloom = document.createElement("div");
            bloom.className = "absolute top-0 left-0 rounded-full bg-white pointer-events-none opacity-0 blur-md will-change-transform";
            bloom.style.width = `${BLOOM_SIZE}px`;
            bloom.style.height = `${BLOOM_SIZE}px`;
            wrap!.appendChild(bloom);
            return bloom;
        });
        let cursor = 0;

        let lastSpawn = 0;

        function spawnBloom(x: number, y: number) {
            const bloom = pool[cursor];
            cursor = (cursor + 1) % pool.length;

            gsap.killTweensOf(bloom);
            gsap.set(bloom, {
                x: x - BLOOM_SIZE / 2,
                y: y - BLOOM_SIZE / 2,
                scale: 1,
                opacity: 0.9,
            });
            gsap.to(bloom, {
                scale: 1.6,
                opacity: 0,
                duration: FADE_DURATION,
                ease: "power2.out",
            });
        }

        function onMove(e: PointerEvent) {
            const now = e.timeStamp || performance.now();
            if (now - lastSpawn < SPAWN_INTERVAL_MS) return;
            lastSpawn = now;

            const rect = host!.getBoundingClientRect();
            spawnBloom(e.clientX - rect.left, e.clientY - rect.top);
        }

        host.addEventListener("pointermove", onMove, { passive: true });
    }

    initCursorFollower();
</script>
