  function rand(min: number, max: number) {
    return min + Math.random() * (max - min);
  }

  // Rasterize each SVG exactly once into a bitmap at device resolution.
  // This is the single biggest win: 4 bitmaps instead of ~3,400 live vector nodes.
  function rasterize(markup: string, w: number, h: number, dpr: number) {
    return new Promise<HTMLCanvasElement>((resolve, reject) => {
      const sized = markup
        .replace(/width="\d+"/, `width="${Math.round(w * dpr)}"`)
        .replace(/height="\d+"/, `height="${Math.round(h * dpr)}"`);
      const img = new Image();
      img.onload = () => {
        const off = document.createElement("canvas");
        off.width = Math.max(1, Math.round(w * dpr));
        off.height = Math.max(1, Math.round(h * dpr));
        off.getContext("2d")!.drawImage(img, 0, 0, off.width, off.height);
        resolve(off);
      };
      img.onerror = reject;
      img.src = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(sized);
    });
  }

  async function init(container: HTMLElement) {
    const canvas = container.querySelector("canvas") as HTMLCanvasElement | null;
    if (!canvas) return () => {};
    const ctx = canvas.getContext("2d", { alpha: true })!;

    const { Engine, Bodies, Composite, Body, Sleeping } = Matter;

    const dpr = Math.min(window.devicePixelRatio || 1, CONFIG.maxDpr);
    let width = container.clientWidth;
    let height = container.clientHeight;

    function sizeCanvas() {
      canvas.width = Math.max(1, Math.round(width * dpr));
      canvas.height = Math.max(1, Math.round(height * dpr));
    }
    sizeCanvas();

    const h = CONFIG.iconHeight;
    const sprites = await Promise.all(
      CONFIG.icons.map((markup, i) =>
        rasterize(markup, h * (CONFIG.iconAspectRatios[i] ?? 1), h, dpr),
      ),
    );

    const engine = Engine.create();
    engine.gravity.y = CONFIG.gravityY;
    // Lets settled piles drop out of the solver entirely instead of being
    // re-resolved forever. Does not change how they fall or land.
    engine.enableSleeping = true;

    const { wallThickness } = CONFIG;
    const ground = Bodies.rectangle(width / 2, height + wallThickness / 2, width * 4, wallThickness, { isStatic: true });
    const leftWall = Bodies.rectangle(-wallThickness / 2, height / 2, wallThickness, height * 4, { isStatic: true });
    const rightWall = Bodies.rectangle(width + wallThickness / 2, height / 2, wallThickness, height * 4, { isStatic: true });
    Composite.add(engine.world, [ground, leftWall, rightWall]);

    type Item = { body: Matter.Body; sprite: HTMLCanvasElement; w: number; h: number };
    const items: Item[] = [];

    function spawnIcon() {
      const idx = Math.floor(Math.random() * sprites.length);
      const w = h * (CONFIG.iconAspectRatios[idx] ?? 1);

      const centerX = width / 2 + rand(-width * CONFIG.spawnXJitter, width * CONFIG.spawnXJitter) / 2;
      const body = Bodies.rectangle(centerX, -CONFIG.spawnYOffset, w, h, {
        restitution: CONFIG.restitution,
        friction: CONFIG.friction,
        frictionAir: CONFIG.frictionAir,
        density: CONFIG.density,
      });

      Body.setVelocity(body, {
        x: rand(CONFIG.velocityXMin, CONFIG.velocityXMax),
        y: rand(CONFIG.velocityYMin, CONFIG.velocityYMax),
      });
      Body.setAngularVelocity(body, rand(CONFIG.angularVelocityMin, CONFIG.angularVelocityMax));

      Composite.add(engine.world, body);
      items.push({ body, sprite: sprites[idx], w, h });
      wake();
    }

    function draw() {
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let i = 0; i < items.length; i++) {
        const it = items[i];
        const p = it.body.position;
        ctx.setTransform(dpr, 0, 0, dpr, p.x * dpr, p.y * dpr);
        ctx.rotate(it.body.angle);
        ctx.drawImage(it.sprite, -it.w / 2, -it.h / 2, it.w, it.h);
      }
    }

    // ---- single loop: physics + draw, fixed timestep ----
    let rafId: number | null = null;
    let last = 0;
    let acc = 0;
    let spawning = true;

    function everythingSettled() {
      if (spawning) return false;
      for (let i = 0; i < items.length; i++) if (!items[i].body.isSleeping) return false;
      return true;
    }

    function frame(now: number) {
      if (!last) last = now;
      let dt = now - last;
      last = now;
      if (dt > 100) dt = 100; // a tab switch shouldn't teleport the pile
      acc += dt;

      let steps = 0;
      while (acc >= CONFIG.fixedStep && steps < CONFIG.maxSubSteps) {
        Engine.update(engine, CONFIG.fixedStep);
        acc -= CONFIG.fixedStep;
        steps++;
      }
      if (acc > CONFIG.fixedStep) acc = 0;

      draw();

      if (everythingSettled()) {
        rafId = null; // canvas keeps the last frame; nothing left to compute
        return;
      }
      rafId = requestAnimationFrame(frame);
    }

    function wake() {
      if (rafId === null && !paused) {
        last = 0;
        acc = 0;
        rafId = requestAnimationFrame(frame);
      }
    }

    // ---- pause when scrolled out of view or tab is hidden ----
    let paused = false;
    function pause() {
      paused = true;
      if (rafId !== null) cancelAnimationFrame(rafId);
      rafId = null;
    }
    function resume() {
      paused = false;
      if (!everythingSettled()) wake();
    }

    const visObserver = new IntersectionObserver(
      ([e]) => (e.isIntersecting ? resume() : pause()),
      { threshold: 0 },
    );
    visObserver.observe(container);

    const onVisibility = () => (document.hidden ? pause() : resume());
    document.addEventListener("visibilitychange", onVisibility);

    // ---- spawning ----
    let spawned = 0;
    const spawnTimer = window.setInterval(() => {
      spawnIcon();
      spawned++;
      if (CONFIG.spawnCount !== null && spawned >= CONFIG.spawnCount) {
        window.clearInterval(spawnTimer);
        spawning = false;
      }
    }, CONFIG.spawnIntervalMs);

    wake();

    // ---- resize: move the walls, don't rebuild the world ----
    let resizeTimer: number | null = null;
    function applyResize() {
      const nw = container.clientWidth;
      const nh = container.clientHeight;
      if (nw === width && nh === height) return;
      width = nw;
      height = nh;
      sizeCanvas();

      Body.setPosition(ground, { x: width / 2, y: height + wallThickness / 2 });
      Body.setPosition(leftWall, { x: -wallThickness / 2, y: height / 2 });
      Body.setPosition(rightWall, { x: width + wallThickness / 2, y: height / 2 });

      for (const { body, w, h: ih } of items) {
        const minX = w / 2;
        const maxX = width - w / 2;
        if (body.position.x < minX || body.position.x > maxX) {
          Body.setPosition(body, {
            x: Math.min(Math.max(body.position.x, minX), maxX),
            y: body.position.y,
          });
        }
        Sleeping.set(body, false); // sleepers must re-settle against the moved walls
      }
      wake();
    }
    function onResize() {
      if (resizeTimer !== null) window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(applyResize, 150);
    }
    const resizeObserver = new ResizeObserver(onResize);
    resizeObserver.observe(container);

    return function destroy() {
      window.clearInterval(spawnTimer);
      if (resizeTimer !== null) window.clearTimeout(resizeTimer);
      if (rafId !== null) cancelAnimationFrame(rafId);
      resizeObserver.disconnect();
      visObserver.disconnect();
      document.removeEventListener("visibilitychange", onVisibility);
      Composite.clear(engine.world, false);
      Engine.clear(engine);
    };
  }

  // Reduced motion: settle the pile silently, paint one frame, never animate.
  async function initStatic(container: HTMLElement) {
    const canvas = container.querySelector("canvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d")!;
    const { Engine, Bodies, Composite, Body } = Matter;

    const dpr = Math.min(window.devicePixelRatio || 1, CONFIG.maxDpr);
    const width = container.clientWidth;
    const height = container.clientHeight;
    canvas.width = Math.round(width * dpr);
    canvas.height = Math.round(height * dpr);

    const h = CONFIG.iconHeight;
    const sprites = await Promise.all(
      CONFIG.icons.map((m, i) => rasterize(m, h * (CONFIG.iconAspectRatios[i] ?? 1), h, dpr)),
    );

    const engine = Engine.create();
    engine.gravity.y = CONFIG.gravityY;
    const t = CONFIG.wallThickness;
    Composite.add(engine.world, [
      Bodies.rectangle(width / 2, height + t / 2, width * 4, t, { isStatic: true }),
      Bodies.rectangle(-t / 2, height / 2, t, height * 4, { isStatic: true }),
      Bodies.rectangle(width + t / 2, height / 2, t, height * 4, { isStatic: true }),
    ]);

    const items: { body: Matter.Body; sprite: HTMLCanvasElement; w: number }[] = [];
    const n = CONFIG.spawnCount ?? 40;
    for (let i = 0; i < n; i++) {
      const idx = Math.floor(Math.random() * sprites.length);
      const w = h * (CONFIG.iconAspectRatios[idx] ?? 1);
      const body = Bodies.rectangle(rand(w, width - w), -rand(50, 600), w, h, {
        restitution: CONFIG.restitution,
        friction: CONFIG.friction,
        frictionAir: CONFIG.frictionAir,
        density: CONFIG.density,
      });
      Body.setAngle(body, rand(-Math.PI, Math.PI));
      Composite.add(engine.world, body);
      items.push({ body, sprite: sprites[idx], w });
    }

    for (let i = 0; i < 900; i++) Engine.update(engine, CONFIG.fixedStep);

    for (const it of items) {
      const p = it.body.position;
      ctx.setTransform(dpr, 0, 0, dpr, p.x * dpr, p.y * dpr);
      ctx.rotate(it.body.angle);
      ctx.drawImage(it.sprite, -it.w / 2, -h / 2, it.w, h);
    }
  }

  function setup() {
    const container = document.getElementById("bin-container");
    if (!container) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let destroy: (() => void) | null = null;

    // Replaces GSAP ScrollTrigger — same "fire once on scroll into view" behaviour,
    // with no 60 KB dependency.
    const trigger = new IntersectionObserver(
      async (entries) => {
        if (!entries[0].isIntersecting) return;
        trigger.disconnect();
        if (reduced) await initStatic(container);
        else destroy = await init(container);
      },
      { rootMargin: CONFIG.triggerRootMargin },
    );
    trigger.observe(container);

    window.addEventListener("pagehide", () => destroy?.(), { once: true });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup);
  } else {
    setup();
  }
</script>