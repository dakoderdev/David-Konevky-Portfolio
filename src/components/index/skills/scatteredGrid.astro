---
import {MY_SKILLS} from "../../../data/skills.ts";

const items = MY_SKILLS.featured;
---

<div id="scattered-stage" class="relative px-4 w-full flex justify-center">
  <div id="scattered-grid" class="relative w-fit grid gap-4 md:gap-8 grid-cols-3 md:grid-cols-4 lg:grid-cols-5 justify-center">
    {items.map((skill) => (
      <div
        class="scattered-square flex flex-col w-24 h-24 sm:w-32 sm:h-32 items-center flex-wrap-balance justify-center gap-2 bg-white shrink-0"
        data-skill={skill.name}
      >
        <img src={skill.svg} alt={skill.name} class="w-1/3 h-1/3 object-contain pointer-events-none" draggable="false" loading="lazy" decoding="async" />
        <span class="text-xs font-medium text-black text-center px-1 pointer-events-none">{skill.name}</span>
      </div>
    ))}
  </div>
  <div id="left-shine" class="hidden sm:block absolute -left-12 top-1/2 -translate-y-1/2 w-16 sm:w-32 bg-linear-to-r from-white/10 to-transparent h-[calc(8rem*2+2rem)]"></div>
  <div id="right-shine" class="hidden sm:block absolute -right-12 top-1/2 -translate-y-1/2 w-16 sm:w-32 bg-linear-to-l from-white/10 to-transparent h-[calc(8rem*2+2rem)]"></div>
</div>

<script>
  import gsap from "gsap";

  // ---- CONFIG: tweak everything here ----
  const CONFIG = {
    minBreakpoint: 640, // px, matches tailwind's `sm`; below this the proximity effect is disabled entirely

    radius: 175, // px, distance from cursor at which scale falls back to 1
    maxScale: 1.15, // scale applied when the cursor is directly over a card
    duration: 0.35, // s, tween duration while tracking the cursor
    leaveDuration: 0.35, // s, multiplier applied on mouseleave (duration * leaveDurationMultiplier)
    leaveDurationMultiplier: 2,
    ease: "power2.out",
  };

  function isDesktop() {
    return window.matchMedia(`(min-width: ${CONFIG.minBreakpoint}px)`).matches;
  }

  function init() {
    const stage = document.getElementById("scattered-stage");
    const container = document.getElementById("scattered-grid");
    if (!stage || !container) return;

    const cards = Array.from(container.querySelectorAll<HTMLElement>(".scattered-square"));
    if (!cards.length) return;

    function resetScales() {
      gsap.set(cards, { scale: 1 });
    }

    function onMouseMove(e: MouseEvent) {
      const { clientX: mx, clientY: my } = e;
      cards.forEach((card) => {
        const r = card.getBoundingClientRect();
        const d = Math.hypot(mx - (r.left + r.width / 2), my - (r.top + r.height / 2));
        const p = gsap.utils.clamp(0, 1, gsap.utils.mapRange(0, CONFIG.radius, 1, 0, d));
        gsap.to(card, {
          scale: 1 + (CONFIG.maxScale - 1) * p,
          duration: CONFIG.duration,
          overwrite: true,
          ease: CONFIG.ease,
        });
      });
    }

    function onMouseLeave() {
      cards.forEach((card) => {
        gsap.to(card, {
          scale: 1,
          duration: CONFIG.duration * CONFIG.leaveDurationMultiplier,
          overwrite: true,
          ease: CONFIG.ease,
        });
      });
    }

    let bound = false;
    function applyMode() {
      const desktop = isDesktop();
      if (desktop && !bound && stage) {
        stage.addEventListener("mousemove", onMouseMove);
        stage.addEventListener("mouseleave", onMouseLeave);
        bound = true;
      } else if (!desktop && bound && stage) {
        stage.removeEventListener("mousemove", onMouseMove);
        stage.removeEventListener("mouseleave", onMouseLeave);
        bound = false;
        resetScales();
      }
    }

    applyMode();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(applyMode, 150);
    });
    
      const leftShine = document.getElementById("left-shine");
      const rightShine = document.getElementById("right-shine");

      gsap.set(leftShine, { transformOrigin: "left center" });
      gsap.set(rightShine, { transformOrigin: "right center" });

      const randomScaleX = () => Math.random() * 0.625;
      const tl = gsap.timeline({ repeat: -1 });

      tl.fromTo(
        leftShine,
        { scaleX: 1 },
        { duration: 0.3, scaleX: randomScaleX },
        0
      )
      .fromTo(
        rightShine,
        { scaleX: 1 },
        { duration: 0.3, scaleX: randomScaleX },
        0
      )
      .to(
        [leftShine, rightShine],
        { duration: 0.1, scaleX: 1 }
      );

      tl.play();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
