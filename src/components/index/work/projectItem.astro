          <circle cx="22.5" cy="16" r="1.125" fill="black" stroke="black" stroke-width="0.25"></circle>
        </svg>
      </span>
      <span class="scramble-target transition-colors">{project.name}</span>
    </h3>
    <span class="project-link -mt-3 sm:m-0 font-pixel text-sm md:text-xl tracking-tight opacity-60 transition-colors">{shortenedUrl}</span>
