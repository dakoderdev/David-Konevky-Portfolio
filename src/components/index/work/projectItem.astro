---
import { Image } from "astro:assets";
const { project } = Astro.props;
const shortenedUrl = project.link.split("/")[2];
---

<a href={project.link} class="flex w-full max-w-3xl flex-col gap-1 mb-4 pb-6 first:mb-0">
  <div class="flex flex-col sm:flex-row justify-start sm:justify-between md:justify-start gap-3 sm:items-end pb-2">
