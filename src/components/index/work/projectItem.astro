<style is:global>
  .scrambled {
    background-color: black;
    color: white;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrambleTextPlugin, ScrollTrigger);

  function scramble(target: HTMLElement, index: number) {
    const text = target.textContent ?? "";
    const isH3 = index % 2 === 0;

    gsap.to(target, {
      duration: isH3 ? 1.4 : 2,

      scrambleText: {
        text,
        chars: "upperCase",
        speed: 0.8,
        oldClass: "scrambled",
      },
      scrollTrigger: {
        trigger: target,
        start: "top 85%",
        once: true,
      },
    });
  }

  const targets = window.matchMedia("(max-width: 767px)").matches ? document.querySelectorAll(".scramble-target") : document.querySelectorAll(".scramble-target, .project-link");
  const images = document.querySelectorAll(".project-image__container");
  targets.forEach((target, index) => {
    scramble(target as HTMLElement, index);
  });

  function scaleFromTop(image: Element) {
    gsap.fromTo(
      image,
      { scale: 0 },
      {
        scale: 1,
        duration: 2,
        stagger: 0.15,
        ease: "expo.inOut",
        scrollTrigger: {
          trigger: image,
          start: "top 85%",
          once: true,
        },
        onComplete: () => {
          image.classList.add("transition-transform", "duration-300", "ease-out");
        },
      },
    );
  }

  images.forEach((image) => {
    scaleFromTop(image);
  });
</script>
