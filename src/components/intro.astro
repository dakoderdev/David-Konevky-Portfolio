<div id="intro-container" class="z-999 fixed pointer-events-none inset-0 bg-white">
    <p id="intro-1" class="absolute top-1/2 left-1/2 opacity-0 -translate-1/2 w-full text-center text-6xl tracking-[-0.03em] font-extralight">Who are you in relation to me?</p>
    <p id="intro-2" class="absolute top-1/2 left-1/2 opacity-0 -translate-1/2 w-full text-center text-6xl tracking-[-0.03em] font-extralight">−I’m an individual made by <strong class="font-medium">many.</strong></p>
</div>

<script>
    import gsap from "gsap";
    
    let intro = gsap.timeline();
    
    intro.fromTo("#intro-1", {opacity: 1}, { opacity: 0, duration: 1, delay: 2.5 })
         .fromTo("#intro-2", { opacity: 0 }, { opacity: 1, duration: 1 })
         .to("#intro-container", { opacity: 0, duration: 1, delay: 2.5 });
</script>