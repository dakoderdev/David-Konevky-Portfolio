<style>
  .selected {
    font-weight: bold;
  }
</style>

<script>
  const keyMap: Record<string, string> = {
    h: "home",
    w: "work",
    b: "blog",
    c: "contact",
  };

  document.addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;

    const target = e.target as HTMLElement;
    if (target.closest("input, textarea, select, [contenteditable='true']")) return;

    const id = keyMap[e.key.toLowerCase()];
    if (!id) return;

    const link = document.getElementById(id);
    if (link instanceof HTMLAnchorElement) {
      e.preventDefault();
      link.click();
    }
  });
</script>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const nav = document.getElementById("site-nav");
  const navIcon = document.getElementById("nav-icon");
  const siteLinks = document.querySelectorAll<HTMLAnchorElement>(".site-link");

  if (nav && navIcon) {
    const LIGHT = { navBg: "bg-white/70", navText: "text-black", iconFill: "fill-black", linkBg: "bg-white/70" };
    const DARK = { navBg: "bg-black/70", navText: "text-white", iconFill: "fill-white", linkBg: "bg-black/70" };

    const setTheme = (theme: "light" | "dark") => {
      const from = theme === "dark" ? LIGHT : DARK;
      const to = theme === "dark" ? DARK : LIGHT;

      nav.classList.remove(from.navBg, from.navText);
      nav.classList.add(to.navBg, to.navText);

      navIcon.classList.remove(from.iconFill);
      navIcon.classList.add(to.iconFill);

      siteLinks.forEach((link) => {
        link.classList.remove(from.linkBg, from.navText);
        link.classList.add(to.linkBg, to.navText);
      });
    };

    // The nav is fixed to the viewport, so its center is a stable screen-space
    // line: whichever section covers that line at any scroll position decides
    // the theme.
    const getNavCenter = () => {
      const rect = nav.getBoundingClientRect();
      return rect.top + rect.height / 2;
    };

    const themedSections = document.querySelectorAll<HTMLElement>("[data-nav-theme]");

    themedSections.forEach((section) => {
      const theme = section.dataset.navTheme === "dark" ? "dark" : "light";

      ScrollTrigger.create({
        trigger: section,
        start: () => `top ${getNavCenter()}px`,
        end: () => `bottom ${getNavCenter()}px`,
        onEnter: () => setTheme(theme),
        onEnterBack: () => setTheme(theme),
        invalidateOnRefresh: true,
      });
    });
  }
</script>
