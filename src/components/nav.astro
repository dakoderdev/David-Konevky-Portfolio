<style>
  .hamburger-icon-open,
  .hamburger-icon-close {
    transition: opacity 300ms ease-in-out;
  }

  #nav-hamburger.nav-hamburger-open .hamburger-icon-open {
    opacity: 0;
  }
  #nav-hamburger.nav-hamburger-open .hamburger-icon-close {
    opacity: 1;
  }
  #nav-hamburger:not(.nav-hamburger-open) .hamburger-icon-close {
    opacity: 0;
  }

  .nav-menu-panel {
    display: flex;
  }

  @media (max-width: 639.98px) {
    .nav-menu-panel {
      position: fixed;
      top: -0.75rem;
      right: -0.75rem;
      bottom: -0.75rem;
      height: calc(100dvh + 1.5rem);
      width: 78vw;
      max-width: 22rem;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 1.5rem;
      padding: 2rem;
      transform: translateX(100%);
      transition: transform 320ms ease-in-out;
      z-index: 990;
    }

    .nav-menu-panel.nav-menu-open {
      transform: translateX(0);
    }
  }
</style>

<script>
  const navLinks = document.querySelectorAll<HTMLAnchorElement>("#site-nav ul a");

  // Shortcut letters come from each link's data-shortcut, so they follow the page language
  const keyMap: Record<string, string> = {};
  navLinks.forEach((link) => {
    if (link.dataset.shortcut) keyMap[link.dataset.shortcut.toLowerCase()] = link.id;
  });

  function setSelected(id: string) {
    navLinks.forEach((link) => {
      if (link.id === id) {
        link.classList.add("font-bold");
      } else {
        link.classList.remove("font-bold");
      }
    });
  }

  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      setSelected(link.id);
      closeMenu();
    });
  });

  const hamburger = document.getElementById("nav-hamburger");
  const menu = document.getElementById("nav-menu");

  function closeMenu() {
    menu?.classList.remove("nav-menu-open");
    hamburger?.setAttribute("aria-expanded", "false");
    hamburger?.classList.remove("nav-hamburger-open");
  }

  function openMenu() {
    menu?.classList.add("nav-menu-open");
    hamburger?.setAttribute("aria-expanded", "true");
    hamburger?.classList.add("nav-hamburger-open");
  }

  hamburger?.addEventListener("click", () => {
    const isOpen = hamburger.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest("#nav-menu-wrapper")) {
      closeMenu();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;

    const target = e.target as HTMLElement;
    if (target.closest("input, textarea, select, [contenteditable='true']")) return;

    const id = keyMap[e.key.toLowerCase()];
    if (!id) return;

    const link = document.getElementById(id);
    if (link instanceof HTMLAnchorElement) {
      e.preventDefault();
      setSelected(id);
      link.click();
    }
  });
</script>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const nav = document.getElementById("site-nav");
  const navIcon = document.getElementById("nav-icon");
  const navLogo = document.getElementById("nav-logo");
  const navMenuWrapper = document.getElementById("nav-menu-wrapper");
  const navMenu = document.getElementById("nav-menu");
  const hamburger = document.getElementById("nav-hamburger");
  const siteLinks = document.querySelectorAll<HTMLAnchorElement>(".site-link");

  if (nav && navIcon) {
    const LIGHT = {
      navBg: "sm:bg-white",
      squareBg: "max-sm:bg-white",
      menuBg: "max-sm:bg-white",
      navText: "text-black",
      iconFill: "fill-black",
      linkBg: "bg-white",
    };
    const DARK = {
      navBg: "sm:bg-black",
      squareBg: "max-sm:bg-black",
      menuBg: "max-sm:bg-black",
      navText: "text-white",
      iconFill: "fill-white",
      linkBg: "bg-black",
    };

    const setTheme = (theme: "light" | "dark") => {
      const from = theme === "dark" ? LIGHT : DARK;
      const to = theme === "dark" ? DARK : LIGHT;

      nav.classList.remove(from.navText);
      nav.classList.add(to.navText);

      nav.classList.remove(from.navBg);
      nav.classList.add(to.navBg);

      [navLogo, navMenuWrapper].forEach((el) => {
        el?.classList.remove(from.squareBg);
        el?.classList.add(to.squareBg);
      });

      navMenu?.classList.remove(from.menuBg);
      navMenu?.classList.add(to.menuBg);

      navIcon.classList.remove(from.iconFill);
      navIcon.classList.add(to.iconFill);

      hamburger?.classList.remove(from.navText);
      hamburger?.classList.add(to.navText);

      siteLinks.forEach((link) => {
        link.classList.remove(from.linkBg, from.navText);
        link.classList.add(to.linkBg, to.navText);
      });
    };

    // The nav is fixed to the viewport, so its center is a stable screen-space
    // line: whichever section covers that line at any scroll position decides
    // the theme.
    const getNavCenter = () => {
      const rect = nav.getBoundingClientRect();
      return rect.top + rect.height / 2;
    };

    const navLinks = document.querySelectorAll<HTMLAnchorElement>("#site-nav ul a");

    const setSelected = (id: string) => {
      navLinks.forEach((link) => {
        link.classList.toggle("font-bold", link.id === id);
      });
    };

    // Some nav links (like Blog) point to a dedicated page rather than an
    // in-page hash, but still have a corresponding section on the homepage
    // that should highlight them while scrolled into view.
    const sectionOverrides: Record<string, string> = {
      blog: "#blog-section",
    };

    navLinks.forEach((link) => {
      const hash = sectionOverrides[link.id] ?? new URL(link.href, location.href).hash;
      const section = hash ? document.querySelector<HTMLElement>(hash) : null;
      if (!section) return;

      ScrollTrigger.create({
        trigger: section,
        start: () => `top ${getNavCenter()}px`,
        end: () => `bottom ${getNavCenter()}px`,
        onEnter: () => setSelected(link.id),
        onEnterBack: () => setSelected(link.id),
        invalidateOnRefresh: true,
      });
    });

    const themedSections = document.querySelectorAll<HTMLElement>("[data-nav-theme]");

    themedSections.forEach((section) => {
      const theme = section.dataset.navTheme === "dark" ? "dark" : "light";

      ScrollTrigger.create({
        trigger: section,
        start: () => `top ${getNavCenter()}px`,
        end: () => `bottom ${getNavCenter()}px`,
        onEnter: () => setTheme(theme),
        onEnterBack: () => setTheme(theme),
        invalidateOnRefresh: true,
      });
    });
  }
</script>
