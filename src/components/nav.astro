    </nav>
</header>

<script>
    import gsap from "gsap";

    const dock = document.querySelector<HTMLElement>("#dock");
    const items = gsap.utils.toArray<HTMLElement>(".dock-item");

    if (dock && items.length) {
        const firstItem = items[0];

        const min = firstItem.offsetWidth + 16; // item width + gap-4
        const max = min * 1.3;                 // magnified footprint
        const bound = min * Math.PI;            // range of influence either side of the pointer

        gsap.set(items, { transformOrigin: "50% 120%" });

        const updateItems = (pointer: number) => {
            items.forEach((item, i) => {
                const distance = i * min + min / 2 - pointer;
                let x = 0;
                let scale = 1;

                if (-bound < distance && distance < bound) {
                    const rad = (distance / min) * 0.5;
                    scale = 1 + (max / min - 1) * Math.cos(rad);
                    x = 2 * (max - min) * Math.sin(rad);
                } else {
                    x = (distance < 0 ? -2 : 2) * (max - min);
                }

                gsap.to(item, { duration: 0.3, x, scale, overwrite: true });
            });
        };

        dock.addEventListener("mousemove", (event) => {
            const offset = dock.getBoundingClientRect().left + firstItem.offsetLeft;
            updateItems(event.clientX - offset);
        });

        dock.addEventListener("mouseleave", () => {
            gsap.to(items, { duration: 0.3, x: 0, scale: 1, overwrite: true });
        });
    }
</script>
