---
interface Skill {
    name: string;
}

interface Props {
    skills: Skill[];
    title: string;
}

const { skills, title } = Astro.props as Props;
import { Image } from "astro:assets";
---

<table class="h-fit border-separate border-spacing-2">
    <thead>
        <tr>
            <th class="flex gap-2 justify-center text-2xl font-normal font-pixel">
                <slot/>
                {title}
            </th>
        </tr>
    </thead>
    <tbody>
        {skills.map((skill) => (
            <tr>
                <td class="flex gap-2">
                    <Image class="p-1 size-6 bg-white" src={skill.svg ? skill.svg : "/skills/nextjs.svg"} alt={"Logo de " + skill.name} width={16} height={16} />
                    {skill.name}
                </td>
            </tr>
        ))}
    </tbody>
</table>