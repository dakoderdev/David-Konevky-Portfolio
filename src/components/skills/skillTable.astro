---
interface Skill {
  name: string;
  svg?: string;
}

interface Props {
  skills: Skill[];
  title: string;
}

const { skills, title } = Astro.props as Props;
import { Image } from "astro:assets";
---

<section class="skill-table @container flex flex-col w-full">
  <button type="button" class="skill-toggle flex w-full min-w-56 items-center justify-between pb-6" aria-expanded="false">
    <div role="heading" aria-level="3" class="flex gap-2 items-center text-2xl font-normal font-pixel">
      <slot />
      {title}
    </div>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="skill-chevron lucide lucide-chevron-up rotate-180"><path d="m18 15-6-6-6 6"></path></svg>
  </button>

  <div class="skill-list-wrapper overflow-hidden h-0">
    <ul class="skill-list grid grid-cols-4 lg:grid-cols-6 lg:w-fit gap-3 place-items-baseline">
      {
        skills.map((skill) => (
          <li class="flex flex-col items-center w-14 text-center gap-2.5 text-[0.625rem] font-medium">
            <Image class="size-8.5 invert-100" src={skill.svg ? skill.svg : "/skills/nextjs.svg"} alt={"Logo de " + skill.name} width={16} height={16} />
            {skill.name}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import gsap from "gsap";

  document.querySelectorAll<HTMLElement>(".skill-table").forEach((table) => {
    const button = table.querySelector<HTMLButtonElement>(".skill-toggle");
    const wrapper = table.querySelector<HTMLElement>(".skill-list-wrapper");
    const chevron = table.querySelector<SVGElement>(".skill-chevron");
    const dotIcon = table.querySelector<SVGElement>(".skill-dot-icon");
    if (!button || !wrapper || !chevron || !dotIcon) return;

    let expanded = false;
    let animating = false;

    button.addEventListener("click", () => {
      if (animating) return;
      animating = true;
      expanded = !expanded;
      button.setAttribute("aria-expanded", String(expanded));

      gsap.to(chevron, {
        rotate: expanded ? 0 : 180,
        duration: 0.35,
        ease: "power2.inOut",
      });

      const currentRotation = Number(gsap.getProperty(dotIcon, "rotation")) || 0;
      gsap.to(dotIcon, {
        rotation: currentRotation + 360,
        duration: 0.7,
        ease: "power2.inOut",
      });

      if (expanded) {
        const targetHeight = wrapper.scrollHeight;
        gsap.fromTo(
          wrapper,
          { height: 0 },
          {
            height: targetHeight,
            duration: 0.4,
            ease: "power2.inOut",
            onComplete: () => {
              gsap.set(wrapper, { height: "auto" });
              animating = false;
            },
          },
        );
      } else {
        gsap.fromTo(
          wrapper,
          { height: wrapper.scrollHeight },
          {
            height: 0,
            duration: 0.4,
            ease: "power2.inOut",
            onComplete: () => {
              animating = false;
            },
          },
        );
      }
    });
  });
</script>
