<script>
    import gsap from "gsap";
    import { InertiaPlugin } from "gsap/InertiaPlugin";

    gsap.registerPlugin(InertiaPlugin);

    let oldX = 0,
    oldY = 0,
    deltaX = 0,
    deltaY = 0;

    const grid = document.querySelector<HTMLDivElement>('#sweepGrid')

    grid?.addEventListener("mousemove", (e) => {
        deltaX = e.clientX - oldX;
        deltaY = e.clientY - oldY;
        oldX = e.clientX;
        oldY = e.clientY;
    })

    grid?.querySelectorAll<HTMLDivElement>('.media').forEach(el => {
        el.addEventListener('mouseenter', () => {
            const tl = gsap.timeline({
                onComplete: () => {
                    tl.kill()
                }
            })
            tl.timeScale(1.2)

            const media = el.querySelector('div')

            tl.to(media, {
               inertia: {
                    x: {
                        velocity: deltaX * 20,
                        end: 0
                    },
                    y: {
                        velocity: deltaY * 20,
                        end: 0
                    },
                },
            })

            tl.fromTo(media, {
                rotate: 0
            }, {
                duration: 0.4,
                rotate: (Math.random() - 0.5) * 30,
                yoyo: true,
                repeat: 1,
                ease: 'power1.inOut'
            }, '<')
        })
        

        const minRandomDelay = 8;
        const maxRandomDelay = 24;

        const media = el.querySelector('div');

        function animateRandomly() {
            const randomDelay = Math.random() * (maxRandomDelay - minRandomDelay) + minRandomDelay;
            const randomRotation = (Math.random() * 30 - 15);

            gsap.delayedCall(randomDelay, () => {
                gsap.to(media, {
                    rotate: randomRotation,
                    duration: 0.5,
                    yoyo: true,
                    repeat: 1,
                    ease: 'power1.inOut',
                    onComplete: animateRandomly
                });
            });
        }

        animateRandomly();
    })
</script>
