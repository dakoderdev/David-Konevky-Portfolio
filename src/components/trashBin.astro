    // native viewBox aspect ratios (w/h) per icon above, used to compute auto width from iconHeight
    iconAspectRatios: [22 / 22, 22 / 22, 22 / 22, 22 / 22, 22 / 22],
  };

  function rand(min: number, max: number) {
    return min + Math.random() * (max - min);
  }

  function init() {
    const container = document.getElementById("bin-container");
    if (!container) return;

    const { Engine, Runner, Bodies, Composite, Body } = Matter;

    const engine = Engine.create();
    engine.gravity.y = CONFIG.gravityY;

    const width = container.clientWidth;
    const height = container.clientHeight;

    const { wallThickness } = CONFIG;
    const ground = Bodies.rectangle(width / 2, height + wallThickness / 2, width * 4, wallThickness, { isStatic: true });
    const leftWall = Bodies.rectangle(-wallThickness / 2, height / 2, wallThickness, height * 4, { isStatic: true });
    const rightWall = Bodies.rectangle(width + wallThickness / 2, height / 2, wallThickness, height * 4, { isStatic: true });
    Composite.add(engine.world, [ground, leftWall, rightWall]);

    const runner = Runner.create();
    Runner.run(runner, engine);

    type IconBody = { body: Matter.Body; el: HTMLElement; w: number; h: number };
    const iconBodies: IconBody[] = [];

    function spawnIcon() {
      const idx = Math.floor(Math.random() * CONFIG.icons.length);
      const svgMarkup = CONFIG.icons[idx];
      const aspect = CONFIG.iconAspectRatios[idx] ?? 1;

      const h = CONFIG.iconHeight;
      const w = h * aspect;

      const el = document.createElement("div");
      el.style.position = "absolute";
      el.style.top = "0";
      el.style.left = "0";
      el.style.width = `${w}px`;
      el.style.height = `${h}px`;
      el.style.pointerEvents = "none";
      el.style.willChange = "transform";
      el.innerHTML = svgMarkup;
      const svgEl = el.querySelector("svg");
      if (svgEl) {
        svgEl.setAttribute("width", String(w));
        svgEl.setAttribute("height", String(h));
      }
      container?.appendChild(el);

      const centerX = width / 2 + rand(-width * CONFIG.spawnXJitter, width * CONFIG.spawnXJitter) / 2;
      const spawnY = -CONFIG.spawnYOffset;

      const body = Bodies.rectangle(centerX, spawnY, w, h, {
        restitution: CONFIG.restitution,
        friction: CONFIG.friction,
        frictionAir: CONFIG.frictionAir,
        density: CONFIG.density,
      });

      Body.setVelocity(body, {
        x: rand(CONFIG.velocityXMin, CONFIG.velocityXMax),
        y: rand(CONFIG.velocityYMin, CONFIG.velocityYMax),
      });
      Body.setAngularVelocity(body, rand(CONFIG.angularVelocityMin, CONFIG.angularVelocityMax));

      Composite.add(engine.world, body);
      iconBodies.push({ body, el, w, h });
    }

    let spawned = 0;
    const spawnTimer = window.setInterval(() => {
      spawnIcon();
      spawned++;
      if (CONFIG.spawnCount !== null && spawned >= CONFIG.spawnCount) {
        window.clearInterval(spawnTimer);
      }
    }, CONFIG.spawnIntervalMs);

    function render() {
      for (const { body, el, w, h } of iconBodies) {
        el.style.transform = `translate(${body.position.x - w / 2}px, ${body.position.y - h / 2}px) rotate(${body.angle}rad)`;
      }
      requestAnimationFrame(render);
    }
    requestAnimationFrame(render);
  }

  function setup() {
    const container = document.getElementById("bin-container");
    if (!container) return;

    ScrollTrigger.create({
      trigger: container,
      start: CONFIG.scrollTriggerStart,
      once: true,
      onEnter: init,
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup);
  } else {
    setup();
  }
