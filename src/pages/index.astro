---
import Layout from "../layouts/layout.astro";
import Intro from "../components/intro.astro";
import HeroSection from "../components/hero/heroSection.astro";
import TrashBin from "../components/miscellaneous-section/trashBin.astro";
import ScatteredGrid from "../components/skills/scatteredGrid.astro";
import SkillTable from "../components/skills/skillTable.astro";
import DotIcon from "../components/skills/dotIcon.astro";
import ProjectItem from "../components/work/projectItem.astro";
import BlogIcon from "../components/blog/blogIcon.astro";

import { MY_SKILLS } from "../data/skills";
import PROJECTS from "../data/projects";
---

<Layout>
  {/*<Intro />*/}
  <HeroSection />
  <section data-nav-theme="light" class="grid lg:grid-cols-2 gap-4 place-items-center">
    <div class="flex flex-col items-center px-4 py-8 sm:pl-12 w-full sm:py-37 gap-4.5">
      <h2 class="text-5xl sm:text-[54px] leading-[1.15] tracking-tight font-pixel w-full sm:min-h-31 font-medium text-balance"><span>Translating</span> <span>your ideas in</span> <span>20/20 vision</span></h2>
      <p class="text-[28px] leading-[1.15] tracking-tight w-full">I love to take a hands-on approach on everything that I do. My work is to build in relation to your needs, filtered through my point of view.</p>
    </div>
    <div class="lg:h-full min-h-92 md:min-h-64 lg:min-h-auto w-full relative overflow-hidden">
      <TrashBin />
    </div>
  </section>
  <section data-nav-theme="dark" class="bg-black px-4 py-8 sm:px-12 w-full text-white sm:py-18 overflow-hidden">
    <h2 class="text-5xl sm:text-[54px] leading-[1.15] tracking-tight text-center font-pixel w-full min-h-31 font-medium text-balance">My Skills</h2>
    <ScatteredGrid />
    <div class="grid md:grid-cols-2 items-start w-full pt-18 gap-y-8 gap-x-12 px-6">
      <SkillTable skills={MY_SKILLS.languages} title="Lenguajes"><DotIcon icon="lenguajes" /></SkillTable>
      <SkillTable skills={MY_SKILLS.frameworks} title="Frameworks"><DotIcon icon="frameworks" /></SkillTable>
      <SkillTable skills={MY_SKILLS.backend} title="Back-end"><DotIcon icon="backend" /></SkillTable>
      <SkillTable skills={MY_SKILLS.design} title="Diseño"><DotIcon icon="diseno" /></SkillTable>
      <SkillTable skills={MY_SKILLS.libraries} title="Librerias"><DotIcon icon="librerias" /></SkillTable>
      <SkillTable skills={MY_SKILLS.infrastructure} title="Infraestructura"><DotIcon icon="infraestructura" /></SkillTable>
    </div>
  </section>
  <section data-nav-theme="light" id="work-section" data-nav-theme="light" class="relative bg-white px-2 py-8 sm:px-12 w-full sm:py-18">
    <h2 class="text-center pb-12 sm:pb-18 text-5xl sm:text-[54px] leading-[1.15] tracking-tight font-pixel font-medium text-balance">My Work</h2>
    <div class="flex flex-col gap-8 sm:gap-24 md:px-12">
      {PROJECTS.map((project) => <ProjectItem project={project} />)}
    </div>
  </section>
  <section data-nav-theme="light" id="blog-section" class="flex flex-col gap-18 px-4 py-8 sm:px-12 sm:pt-24 sm:pb-37">
    <div class="flex flex-col justify-between lg:flex-row items-center">
      <div class="flex flex-col max-w-2xl gap-4.5">
        <h2 class="text-5xl sm:text-[54px] leading-[1.15] text-balance tracking-tight font-pixel w-full min-h-31 font-medium">If you want to learn more about the making-of:</h2>
        <p class="text-[28px] leading-[1.15] tracking-tight w-full">Here are some articles about my existing, ongoing, and future projects. They contain countless amounts of information about my design and development process, from early ideas to final execution.</p>   
      </div>
      <BlogIcon />
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-0.5">
      <div class="bg-black aspect-4/3"></div>
      <div class="bg-black aspect-4/3"></div>
      <div class="bg-black aspect-4/3"></div>
    </div>
  </section>
</Layout>

<script>
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(SplitText, ScrollTrigger);

  function typewriter(header: HTMLElement) {
    const split = SplitText.create(header, { type: "chars" });
    header.style.willChange = "contents";

    const cursor = document.createElement("span");
    cursor.textContent = "|";
    cursor.style.opacity = "0";
    cursor.style.marginLeft = "1px";
    header.appendChild(cursor);

    gsap.set(split.chars, { autoAlpha: 0 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: header,
        start: "top 85%",
        once: true,
      },
      onStart: () => {
        gsap.set(cursor, { autoAlpha: 1 });
      },
      onComplete: () => {
        header.style.willChange = "auto";
        cursor.remove();
      },
    });

    split.chars.forEach((char) => {
      // slight randomness per character mimics real keystrokes instead of a metronome tick
      tl.to(
        char,
        {
          autoAlpha: 1,
          duration: 0.02,
          onStart: () => char.after(cursor),
        },
        `+=${gsap.utils.random(0.015, 0.06)}`,
      );

      // occasional longer pause, like a natural typing hesitation
      if (Math.random() < 0.08) {
        tl.to({}, { duration: gsap.utils.random(0.08, 0.18) });
      }
    });
  }

  const headers = document.querySelectorAll("h2");

  headers.forEach((header) => {
    typewriter(header);
  });
</script>
