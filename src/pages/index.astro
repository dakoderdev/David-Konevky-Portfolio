---
import Layout from "../layouts/layout.astro";
import HeroSection from "../components/index/hero/heroSection.astro";
import TrashBin from "../components/index/miscellaneous-section/trashBin.astro";
import ScatteredGrid from "../components/index/skills/scatteredGrid.astro";
import SkillTable from "../components/index/skills/skillTable.astro";
import DotIcon from "../components/index/skills/dotIcon.astro";
import ProjectItem from "../components/index/work/projectItem.astro";
import BlogIcon from "../components/index/blog/blogIcon.astro";
import EducationSection from "../components/index/education/educationSection.astro";

import { Image } from "astro:assets";

import { MY_SKILLS } from "../data/skills";
import PROJECTS from "../data/projects";
import { getCollection } from "astro:content";

const postsRecent = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 3);
---

<Layout>
  <HeroSection />
  <section data-nav-theme="light" class="grid lg:grid-cols-2 gap-4 place-items-center">
    <div class="flex flex-col items-center px-4 py-8 sm:pl-12 w-full sm:py-37 gap-4.5">
      <h2 class="text-5xl sm:text-[54px] leading-[1.15] tracking-tight font-pixel w-full sm:min-h-31 font-medium text-balance"><span>Translating</span> <span>your ideas in</span> <span>20/20 vision</span></h2>
      <p class="text-[28px] leading-[1.15] tracking-tight w-full">I love to take a hands-on approach on everything that I do. My work is to build in relation to your needs, filtered through my specific and personal point of view.</p>
    </div>
    <div class="lg:h-full min-h-92 md:min-h-64 lg:min-h-auto w-full relative overflow-hidden">
      <TrashBin />
    </div>
  </section>
  <section data-nav-theme="dark" class="bg-black px-4 py-8 sm:px-12 w-full text-white sm:py-18 overflow-hidden">
    <h2 class="text-5xl sm:text-[54px] leading-[1.15] tracking-tight text-center font-pixel w-full min-h-31 font-medium text-balance">My Skills</h2>
    <ScatteredGrid />
    <div class="grid md:grid-cols-2 items-start w-full pt-18 gap-y-8 gap-x-12 px-6">
      <SkillTable skills={MY_SKILLS.languages} title="Languages"><DotIcon icon="lenguajes" /></SkillTable>
      <SkillTable skills={MY_SKILLS.frameworks} title="Frameworks"><DotIcon icon="frameworks" /></SkillTable>
      <SkillTable skills={MY_SKILLS.backend} title="Back-end"><DotIcon icon="backend" /></SkillTable>
      <SkillTable skills={MY_SKILLS.design} title="Design"><DotIcon icon="diseno" /></SkillTable>
      <SkillTable skills={MY_SKILLS.libraries} title="Libraries"><DotIcon icon="librerias" /></SkillTable>
      <SkillTable skills={MY_SKILLS.infrastructure} title="Infrastructure"><DotIcon icon="infraestructura" /></SkillTable>
    </div>
  </section>
  <section data-nav-theme="light" id="work-section" data-nav-theme="light" class="relative bg-white px-4 py-8 sm:px-12 w-full sm:py-18">
    <h2 class="text-center pb-12 sm:pb-18 text-5xl sm:text-[54px] leading-[1.15] tracking-tight font-pixel font-medium text-balance">My Work</h2>
    <div class="flex flex-col items-center gap-8 sm:gap-24 md:px-12">
      {PROJECTS.map((project) => <ProjectItem project={project} />)}
    </div>
  </section>
  <EducationSection />
  <section id="blog-section" data-nav-theme="light" class="flex flex-col gap-2 sm:gap-3 px-4 py-8 overflow-hidden sm:px-12 sm:pt-24 sm:pb-37">
    <div class="flex flex-col justify-between lg:flex-row pb-6 sm:pb-18 items-center">
      <div class="flex flex-col max-w-2xl gap-4.5 pb-15">
        <h2 class="text-5xl sm:text-[54px] leading-[1.15] text-balance tracking-tight font-pixel w-full min-h-31 font-medium">If you want <span>to learn more </span> <span>about</span> <span>the making-of:</span></h2>
        <div class="flex">
          <p class="text-[28px] leading-[1.15] tracking-tight w-full">Here are some articles about my existing, ongoing, and future projects. They contain countless amounts of information about my design and development process, from early ideas to final execution.</p>   
        </div>
      </div>
      <div class="w-auto h-72 pt-4 sm:pt-0 sm:h-auto overflow-hidden sm:overflow-visible">
        <BlogIcon />
      </div>
    </div>
    <ul class="grid sm:grid-cols-2 md:grid-cols-3 gap-3 w-full">
            {postsRecent.map((post) => (
                <li>
                    <a href={`/blog/${post.data.slug ?? post.id}`}>
                        <Image class="object-cover aspect-video pb-2" src={post.data.cover} alt={post.data["cover-alt"]} width={768} height={432}/>
                        <h3 class="text-xl tracking-tight font-pixel pb-0.5">{post.data.title}</h3>
                        <p class="text-sm text-black/80 text-end">{post.data.date.toLocaleDateString()}</p>
                    </a>
                </li>
            ))}
        </ul>
    <a href="/blog" class="bg-black/20 font-medium text-sm w-fit py-2 px-6 mx-auto">
      See More
    </a>
  </section>
</Layout>

<script>
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(SplitText, ScrollTrigger);

  function typewriter(header: HTMLElement) {
    const split = SplitText.create(header, { type: "chars" });
    header.style.willChange = "contents";

    const cursor = document.createElement("span");
    cursor.textContent = "|";
    cursor.style.opacity = "0";
    cursor.style.marginLeft = "1px";
    header.appendChild(cursor);

    gsap.set(split.chars, { autoAlpha: 0 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: header,
        start: "top 85%",
        once: true,
      },
      onStart: () => {
        gsap.set(cursor, { autoAlpha: 1 });
      },
      onComplete: () => {
        header.style.willChange = "auto";
        cursor.remove();
      },
    });

    split.chars.forEach((char) => {
      // slight randomness per character mimics real keystrokes instead of a metronome tick
      tl.to(
        char,
        {
          autoAlpha: 1,
          duration: 0.02,
          onStart: () => char.after(cursor),
        },
        `+=${gsap.utils.random(0.015, 0.06)}`,
      );

      // occasional longer pause, like a natural typing hesitation
      if (Math.random() < 0.08) {
        tl.to({}, { duration: gsap.utils.random(0.08, 0.18) });
      }
    });
  }

  const headers = document.querySelectorAll("h2");

  headers.forEach((header) => {
    typewriter(header);
  });
</script>
