---
import Layout from "../layouts/layout.astro";
import Intro from "../components/intro.astro";
import HeroSection from "../components/heroSection.astro";
---

<Layout>
	{/*<Intro />*/}
	<HeroSection />
	<section class="grid sm:grid-cols-2 px-12 py-37">
		<div class="flex flex-col gap-4.5">
			<h2 class="text-[54px] leading-[1.15] tracking-tight font-medium text-balance">Inspired by everything, everywhere, all at once</h2>
			<p class="text-[28px] leading-[1.15] tracking-tight">My work is to build in relation to your needs, filtered through my point of view. I love to take a hands-on approach on everything that I do.</p>
		</div>
	</section>
</Layout>
